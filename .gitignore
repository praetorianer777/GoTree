# Go
/gotree
/dist/
coverage.out

# Frontend
web/node_modules/
web/.e2e-data/
web/test-results/
web/playwright-report/
# web/dist/.gitkeep stays so go:embed compiles before the first frontend build;
# web/public/.gitkeep puts it back after every build, which empties dist/
web/dist/*
!web/dist/.gitkeep

# Runtime data (SQLite database, uploaded media)
/data/

# IDE
.idea/
.vscode/

# agent worktrees
.claude/worktrees/

# release notes are generated by release.sh and read from the tag message
release-notes-*.md
